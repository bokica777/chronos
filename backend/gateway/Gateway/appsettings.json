{
  "Services": {
    "Auth": "http://auth-api:8080",
    "Provider": "http://provider-api:8080",
    "Booking": "http://booking-api:8080",
    "Payment": "http://payment-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "booking-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/api/v1/bookings/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "provider-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/api/v1/providers/{**catch-all}"
        }
      },
      "category-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "public-services-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/api/v1/services/{**catch-all}"
        }
      },
      "uploads-route": {
        "ClusterId": "provider-cluster",
        "Match": {
          "Path": "/uploads/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "booking-cluster": {
        "Destinations": {
          "booking-destination": {
            "Address": "http://booking-api:8080"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth-api:8080"
          }
        }
      },
      "provider-cluster": {
        "Destinations": {
          "provider-destination": {
            "Address": "http://provider-api:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://payment-api:8080"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["https://chronos.example.com"]
  }
}
