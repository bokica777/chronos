# Kopiraj u "infra/docker/.env" (isti folder) i popuni. .env NE ide na git.
# docker compose ga automatski cita kad se pokrene sa -f infra/docker/compose.yaml.

# --- Mejlovi (Gmail App Password, vidi docs/notification-email-setup.md) ---
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tvoj.nalog@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=tvoj.nalog@gmail.com

# --- Adresa racunara ---
# localhost = radi samo na ovom racunaru. Za QR kod sa telefona upisi IP
# racunara u lokalnoj mrezi (npr. 192.168.1.10) - onda i frontend i API idu
# preko te adrese. Posle promene: docker compose ... up --build frontend
CHRONOS_HOST=localhost

# --- Booking verzija (v1 / v2 / v3), podrazumevano v1 ---
BOOKING_VERSION=v1
